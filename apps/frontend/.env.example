# ==========================================
# 🎵 TuneTrend Frontend - Environment Variables
# ==========================================

# ------------------------------------------
# 🔗 Backend API
# ------------------------------------------

# URL ของ Go backend (apps/backend) — ตั้งใจไม่ใส่ prefix NEXT_PUBLIC_
# เพราะตัวแปรนี้ต้องอ่านได้แค่ฝั่ง Server Component เท่านั้น ห้ามหลุดไปฝั่ง browser
# (ดูเหตุผลเพิ่มเติมที่ apps/frontend/lib/api.ts)

# [Local] รัน backend เองในเครื่องด้วย `air`/`go run` (ดู apps/backend/.env.example)
API_BASE_URL=http://localhost:8080

# ------------------------------------------
# 🚦 Rate Limiting (Upstash Redis)
# ------------------------------------------

# ใช้โดย proxy.ts (Next.js Middleware) เพื่อจำกัดจำนวน request ต่อ IP —
# เอาค่ามาจาก Upstash Console > Redis database > REST API เท่านั้น
# (ไม่ใช่ TCP connection string) ห้ามใส่ prefix NEXT_PUBLIC_ เด็ดขาด เพราะเป็น
# credential ที่ต้องอยู่ฝั่ง server/middleware เท่านั้น
UPSTASH_REDIS_REST_URL=https://your-db-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token

# ------------------------------------------
# 📲 Install Prompt (Android/iOS app vs PWA)
# ------------------------------------------
# ต้องมี prefix NEXT_PUBLIC_ เพราะอ่านใน browser ตรงๆ (components/InstallPrompt.tsx
# เป็น client component) — ไม่ใช่ secret เหมือนตัวแปรด้านบน

# ค่าที่ใช้ได้: "play-store" | "pwa" | "disabled" — ไม่ตั้งจะ default เป็น "play-store"
# "play-store" = กัน browser prompt ติดตั้ง PWA แล้วชวนโหลดแอปจริงจาก Google Play แทน
# หมายเหตุ: ตั้งแต่แอป Android ขึ้น Play Store จริงแล้ว app/manifest.ts ประกาศ
# prefer_related_applications = true ทำให้ Chrome เลิกยิง beforeinstallprompt
# โหมด "pwa" จึงติดตั้ง PWA ไม่ได้อีกต่อไป และจะ fallback ไปชวนโหลดจาก Play Store แทน
NEXT_PUBLIC_INSTALL_ANDROID_MODE=play-store

# ค่าที่ใช้ได้: "app-store" | "pwa" | "disabled" — ไม่ตั้งจะ default เป็น "pwa"
NEXT_PUBLIC_INSTALL_IOS_MODE=pwa

# ปล่อยขึ้น Google Play จริงแล้ว — ไม่ตั้งตัวนี้จะ fallback เป็น URL ที่สร้าง
# จาก applicationId เดียวกัน (apps/mobile/android/app/build.gradle.kts) ซึ่งใช้งานได้ปกติ
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.tunetrend.tunetrend_mobile

# ยังไม่มี iOS app จริง — ต้องตั้งค่านี้เองก่อนเปลี่ยน NEXT_PUBLIC_INSTALL_IOS_MODE
# เป็น "app-store" ไม่งั้น modal จะไม่โชว์ (กัน link เสีย)
NEXT_PUBLIC_APP_STORE_URL=