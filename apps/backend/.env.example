# ==========================================
# 🎵 TuneTrend Backend - Environment Variables
# ==========================================

# ------------------------------------------
# 🗄️ Database Configuration
# ------------------------------------------

# [Option A] แบบ URL เส้นเดียว (แนะนำสำหรับต่อ Supabase)
# ถ้ามีตัวแปรนี้ ระบบจะใช้ตัวนี้เป็นหลัก (ไม่ต้องอ่าน Option B)
# เอามาจาก Supabase > Settings > Database > Connection string > URI
# DATABASE_URL=postgresql://postgres:your_password@db.xxxxxxxxxxxxxxxxxxxx.supabase.co:5432/postgres?sslmode=require

# [Option B] แบบแยกตัวแปร (สำหรับรัน Local ด้วย Docker Compose เครื่องตัวเอง)
# หากจะใช้ Option B ให้ใส่ # คอมเมนต์บรรทัด DATABASE_URL ด้านบนไว้
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tunetrend
DB_PORT=5432
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Bangkok

# ------------------------------------------
# ⚙️ Server Configuration
# ------------------------------------------
# พอร์ตสำหรับรันบนเครื่อง Local (ส่วนบน Render จะถูกข้ามไป)
PORT=8080
APP_ENV=local

# เปิด/ปิด Swagger UI (/docs) แยกจาก APP_ENV โดยตั้งใจ กัน APP_ENV ตั้งผิด/ไม่ตั้งแล้วเผลอเปิด Docs บน Production
# ค่า Default ถ้าไม่ตั้งคือ "ปิด" ต้องตั้ง true ตรงๆ เท่านั้นถึงจะเปิด (ใส่ true เฉพาะ Local/Staging)
SWAGGER_ENABLED=true

# Host ที่จะแสดงใน Swagger UI ตอน APP_ENV=prod เท่านั้น (เช่น URL จริงของ backend
# บน Render) — ตั้งใจแยกออกจาก source code เพื่อไม่ให้ domain จริงหลุดไปกับ repo
# ถ้าเป็น public repo ไม่ต้องตั้งก็ได้ถ้าไม่เปิด Swagger บน prod อยู่แล้ว
SWAGGER_HOST=your-backend-domain.example.com

# Origin ที่อนุญาตให้เรียก API ผ่าน browser ได้ (comma-separated ได้ถ้ามีหลาย origin)
# ค่า Default ถ้าไม่ตั้งคือ "*" (เปิดทุก origin) — ใช้ได้เฉพาะตอน Local เท่านั้น
# บน Production (Render) ต้องตั้งเป็น origin จริงของ frontend เสมอ อย่าปล่อยเป็น *
CORS_ALLOW_ORIGINS=*

# ------------------------------------------
# 🎥 External APIs
# ------------------------------------------
# คีย์สำหรับดึงข้อมูลชาร์ตเพลงจาก YouTube Data API v3
YOUTUBE_API_KEY=XyGd_ใส่คีย์ของคุณที่นี่_0Ot3F0ur

# ------------------------------------------
# 🚦 Rate Limiting (Upstash Redis)
# ------------------------------------------
# ตัวเดียวกับที่ apps/frontend ใช้ — เอามาจาก Upstash Console > Redis database
# > REST API (ไม่ใช่ TCP connection string) ถ้าไม่ตั้งค่าคู่นี้ไว้ ระบบจะ
# ปล่อยผ่านทุก request แบบไม่จำกัด (fail-open) ไม่ error
UPSTASH_REDIS_REST_URL=https://your-db-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token

# ------------------------------------------
# 📧 SMTP (Contact Form Email Notification)
# ------------------------------------------
